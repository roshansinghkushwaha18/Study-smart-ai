# StudySmart AI - Environment Variables Configuration Template
# Duplicate this file as '.env' and insert your OpenAI API Key.

# Server host and port (default local-only URL: http://127.0.0.1:5000)
HOST=127.0.0.1
PORT=5000

# Provider switch: openai | ollama | groq | gemini
# Default free local option: ollama -> http://127.0.0.1:11434/v1
AI_PROVIDER=ollama

# OpenAI optional, only used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama local free provider
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Optional third-party providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOCAL_TUTOR_FALLBACK=true
